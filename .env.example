# Razorpay keys — get them from https://dashboard.razorpay.com (Settings → API Keys).
# Use TEST keys while trying things out; switch to LIVE keys after KYC to take real money.
#
# Do NOT commit your real .env file. On Vercel, add these under
# Project → Settings → Environment Variables instead.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here
